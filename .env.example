# All optional. Defaults work out of the box for local runs.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Routing (free, no key). Point at a self-hosted OSRM for production traffic.
OSRM_BASE_URL=https://router.project-osrm.org
# Optional fallback if OSRM is down: free key from openrouteservice.org
ORS_API_KEY=

# Vehicle and planner
VEHICLE_RANGE_MILES=500
VEHICLE_MPG=10
START_FUEL=full
CORRIDOR_MILES=10
STOP_PENALTY_USD=5
